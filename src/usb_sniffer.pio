;
; @file usb_sniffer.pio
; @brief PIO hardware DPLL for passive USB 1.1 sampling (Low-Speed & Full-Speed).
;
; Runs at 8x bit rate (12 MHz for LS, 96 MHz for FS), tracks edges on D+
; (JMP_PIN), and captures one 2-bit [D+, D-] symbol at the exact center
; of each USB bit period (1x bit-rate output, 16 USB bits per 32-bit word).
;
; This reduces DMA/CPU bandwidth by 8x compared to raw 8x oversampling,
; allowing the RP2040 Cortex-M0+ to decode Full-Speed (12 Mbps) traffic
; in real time.
;
; usb_sniffer.pio.h is generated from this file: never edit it by hand.
; After changing this file, regenerate the header from the src/ folder with
; the pioasm bundled with arduino-pico (tools/pqt-pioasm):
;   pioasm -o c-sdk usb_sniffer.pio usb_sniffer.pio.h
; @author Ângelo Moisés Alves
; @version 2.0.0
;

.program usb_sniffer

public sample_high:
    in pins, 2          ; t=4:  sample center of bit (D+ == 1)
    nop                 ; t=5:  guard cycle
    jmp pin, h_t7       ; t=6:  if D+==1 continue; else falling edge at t=6
    jmp sample_low [2]  ; t=7..9 -> sample_low at t=10 (6 + 4)
h_t7:
    jmp pin, h_t8       ; t=7:  falling edge at t=7?
    jmp sample_low [2]  ; t=8..10 -> sample_low at t=11 (7 + 4)
h_t8:
    jmp pin, h_t9       ; t=8:  falling edge at t=8 (nominal)?
    jmp sample_low [2]  ; t=9..11 -> sample_low at t=12 (8 + 4)
h_t9:
    jmp pin, h_t10      ; t=9:  falling edge at t=9?
    jmp sample_low [2]  ; t=10..12 -> sample_low at t=13 (9 + 4)
h_t10:
    jmp pin, h_noedge   ; t=10: falling edge at t=10?
    jmp sample_low [2]  ; t=11..13 -> sample_low at t=14 (10 + 4)
h_noedge:
    jmp sample_high     ; t=11: no edge -> sample_high at t=12 (4 + 8)

sample_low:
    in pins, 2          ; t=4:  sample center of bit (D+ == 0)
    nop                 ; t=5:  guard cycle
    jmp pin, edge_hi    ; t=6:  rising edge at t=6?
    jmp pin, edge_hi    ; t=7:  rising edge at t=7?
    jmp pin, edge_hi    ; t=8:  rising edge at t=8 (nominal)?
    jmp pin, edge_hi    ; t=9:  rising edge at t=9?
    jmp pin, edge_hi    ; t=10: rising edge at t=10?
    jmp sample_low      ; t=11: no edge -> sample_low at t=12 (4 + 8)
edge_hi:
    jmp sample_high [2] ; t=E+1..E+3 -> sample_high at t=E+4

% c-sdk {
/**
 * @brief Sets D+ and D- up as high-impedance PIO inputs and starts the DPLL.
 *
 * @param pio     PIO instance that holds the program (pio0 or pio1).
 * @param sm      State machine to run it on.
 * @param offset  Load offset returned by pio_add_program().
 * @param pin_dp  GPIO of D+; D- is pin_dp + 1.
 * @param div     State machine clock divider (8 PIO cycles per USB bit).
 */
static inline void usb_sniffer_program_init(
    PIO   pio,
    uint  sm,
    uint  offset,
    uint  pin_dp,
    float div
) {
    /* Configure both pins as high-impedance inputs */
    pio_sm_set_consecutive_pindirs(pio, sm, pin_dp, 2, false);

    gpio_disable_pulls(pin_dp);
    gpio_disable_pulls(pin_dp + 1);

    /* Enable input hysteresis for noise rejection */
    gpio_set_input_hysteresis_enabled(pin_dp,     true);
    gpio_set_input_hysteresis_enabled(pin_dp + 1, true);

    /* Assign pins to the correct PIO instance */
    gpio_function_t pio_func = (gpio_function_t)(GPIO_FUNC_PIO0 + (pio == pio1 ? 1 : 0));
    gpio_set_function(pin_dp,     pio_func);
    gpio_set_function(pin_dp + 1, pio_func);

    /* Build SM configuration (the generated default sets wrap 0..21) */
    pio_sm_config c = usb_sniffer_program_get_default_config(offset);
    sm_config_set_in_pins(&c, pin_dp);             /* IN base = D+ (bit0=D+, bit1=D-) */
    sm_config_set_jmp_pin(&c, pin_dp);             /* JMP pin = D+ (edge DPLL)        */
    sm_config_set_in_shift(&c, true, true, 32);    /* Shift right, autopush @ 32 bits */
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX); /* 8-deep RX FIFO                  */
    sm_config_set_clkdiv(&c, div);

    /* Apply and start */
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
